{
  "ConnectionStrings": {
    "Sendly": "Data Source=App_Data/Sendly.db"
  },
  "SecretProtection": {
    "EncryptionKey": ""
  },
  "EmailSending": {
    "DefaultDelayMilliseconds": 1000,
    "DefaultBatchSize": 50,
    "DefaultMaxRetryCount": 2,
    "ConnectionTimeoutSeconds": 30
  },
  "Attachments": {
    "MaxFileSizeBytes": 5242880,
    "MaxTotalSizeBytes": 20971520,
    "StorageRoot": "App_Data/attachments",
    "AllowedContentTypes": [
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "image/png",
      "image/jpeg",
      "image/gif",
      "text/plain",
      "text/csv",
      "application/zip"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
